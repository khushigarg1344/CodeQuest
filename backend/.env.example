# Copy to .env and set your local PostgreSQL credentials. Never commit .env.
DATABASE_URL=sqlite:///./codequest.db  # local development; keep SQLite for now
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
